+
+    void set_input(const llama_ubatch * ubatch) override;
+
+    ggml_tensor * mask = nullptr; // F32 [n_tokens, n_adapters]; column k = 1.0 where token's seq routes to adapter k
+
+    const int32_t * seq_adapter_map;
